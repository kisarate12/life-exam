# =====================================================
# 相談返信ダッシュボード 環境変数
# =====================================================
# コピーして .env.local に保存し、値を入れて使用すること。

# アプリの公開 URL（OAuth コールバックに使用）
NEXT_PUBLIC_APP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth（Gmail API・Google Chat API 共通）
# GCP コンソール → APIs & Services → Credentials で作成
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth（api.slack.com/apps でアプリを作成）
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Anthropic API（AI 下書き生成）
ANTHROPIC_API_KEY=

# トークン暗号化キー（hex 64文字 = 32バイトの AES-256 キー）
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
